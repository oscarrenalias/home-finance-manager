# SQLAlchemy connection URL for the SQLite database; four slashes = absolute path
DATABASE_URL=sqlite:////data/db/home_finances.db

# Base URL of the LiteLLM proxy sidecar (matches the service name in docker-compose)
LITELLM_BASE_URL=http://litellm:4000

# LiteLLM model name used for fast, low-cost transaction classification
LITELLM_CLASSIFIER_MODEL=classifier

# LiteLLM model name used for complex conversational analysis queries
LITELLM_ANALYST_MODEL=analyst

# Absolute path inside the container where uploaded CSV import files are stored
IMPORT_FILES_DIR=/data/imports

# API key for your LLM provider — supplied to LiteLLM at runtime, never committed
OPENAI_API_KEY=sk-...

# Optional: LiteLLM proxy master key for internal service authentication
# Leave blank to disable authentication (safe for a private home network)
LITELLM_MASTER_KEY=
